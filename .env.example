# --- Security / JWT ---
JWT_SECRET=dev-secret-change-in-prod-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- LLM / Provider Keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- App ---
DECISION_ARCHIVE_PATH=data/decisions_archive.jsonl
PINECONE_API_KEY=
PINECONE_INDEX_NAME=decision-archive
EMBEDDING_MODEL=models/text-embedding-004
AI_ENABLED=false 
AI_TIMEOUT_SECONDS=30

# --- SAP S/4HANA odata Bridge---
# Leave S4_BASE_URL empty to run on seed data only.
# Points at the ICF service created per abap/README.md, e.g.
#   http://<sap-host>:8000

SAP_BASE_URL=sap url
SAP_USERNAME=your_username
SAP_PASSWORD=your_password
SAP_CLIENT = 000
SAP_VERIFY_TLS=false
S4_SYNC_ON_BOOT=true
S4_MERGE_NODES=true
