# --- Default LLM via OmniRouter (always available) ---
OMNIROUTE_API_KEY=your-key-here

# --- Optional: direct provider keys (for per-company switching) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- App ---
AI_ENABLED=true
AI_TIMEOUT_SECONDS=15

# --- SAP S/4HANA odata
SAP_BASE_URL=sap url
SAP_USERNAME=your_username
SAP_PASSWORD=your_password
SAP_CLIENT = 000
SAP_VERIFY_TLS=false
S4_SYNC_ON_BOOT=true
S4_MERGE_NODES=true
