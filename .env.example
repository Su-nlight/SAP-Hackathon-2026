# --- Default LLM via OmniRouter (always available) ---
OMNIROUTE_API_KEY=your-key-here

# --- Optional: direct provider keys (for per-company switching) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- App ---
AI_ENABLED=true
AI_TIMEOUT_SECONDS=15

# --- SAP S/4HANA bridge (optional) ---
# Leave S4_BASE_URL empty to run on seed data only.
# Points at the ICF service created per abap/README.md, e.g.
#   http://<sap-host>:8000
S4_BASE_URL=
S4_USERNAME=
S4_PASSWORD=
S4_CLIENT=000
S4_VERIFY_TLS=false
S4_SYNC_ON_BOOT=true
S4_MERGE_NODES=true
